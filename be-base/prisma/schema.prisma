generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String   @id
  userId           String
  userEmail        String   @default("")
  userType         String   @default("admin")
  isAdmin          Boolean  @default(false)
  refreshTokenHash String
  deviceName       String
  ipAddress        String
  userAgent        String
  isActive         Boolean  @default(true)
  lastActiveAt     DateTime
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Admin {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admins")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl    String?
  role         String   @default("member")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("users")
}

model PasswordResetToken {
  id        String    @id
  userId    String
  userType  String
  userEmail String    @default("")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, userType])
  @@map("password_reset_tokens")
}

// ── Authorization ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id
  name        String
  description String?
  subjectType String   // 'admin' | 'user' | 'merchant' | '*'
  parentId    String?
  parent      Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]   @relation("RoleHierarchy")

  assignments RoleAssignment[]
  permissions Permission[]

  @@unique([name, subjectType])
  @@map("roles")
}

model RoleAssignment {
  id          String   @id
  subjectId   String
  subjectType String   // 'admin' | 'user' | 'merchant'
  roleId      String
  createdAt   DateTime @default(now())
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([subjectId, subjectType, roleId])
  @@index([subjectId, subjectType])
  @@map("role_assignments")
}

model Permission {
  id       String   @id
  roleId   String
  resource String   // '*' = all resources
  actions  String[] // Action[]
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("permissions")
}

// ── Audit ──────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  actorRole  String
  resource   String
  permission String
  method     String
  path       String
  statusCode Int
  durationMs Int
  ipAddress  String
  userAgent  String
  occurredAt DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([occurredAt])
  @@index([resource, occurredAt])
  @@map("audit_logs")

}
// ── Media ─────────────────────────────────────────────────────────────────────

model MediaFolder {
  id        String        @id
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
  files     MediaFile[]
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("media_folders")
}

model MediaFile {
  id           String       @id
  key          String       @unique
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String
  thumbnailKey String?
  thumbnailUrl String?
  alt          String?
  scope        String       @default("public")
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         String[]
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([scope, folderId])
  @@index([mimeType])
  @@map("media_files")
}

// ── Notification ──────────────────────────────────────────────────────────────

model Notification {
  id         String   @id
  type       String   // 'system' | 'info' | 'warning' | 'alert' | 'success'
  title      String
  body       String
  data       Json?
  senderId   String?
  senderType String?  // 'admin' | 'system'
  createdAt  DateTime @default(now())

  recipients NotificationRecipient[]

  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id
  notificationId String
  recipientId    String
  recipientType  String    // 'user' | 'admin'
  isRead         Boolean   @default(false)
  readAt         DateTime?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientId, recipientType])
  @@index([recipientId, recipientType])
  @@map("notification_recipients")
}

model NotificationPreference {
  id            String   @id
  recipientId   String
  recipientType String   // 'user' | 'admin'
  type          String
  isEnabled     Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([recipientId, recipientType, type])
  @@map("notification_preferences")
}

// ── Blog ──────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String        @id
  slug        String        @unique
  title       String
  content     String        @db.Text
  contentType String        @default("markdown")
  excerpt     String?
  status      String        @default("draft")
  coverFileId String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String[]
  authorId    String?
  metaTitle   String?
  metaDesc    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogCategory {
  id          String     @id
  name        String     @unique
  slug        String     @unique
  description String?
  coverFileId String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_categories")
}

// ── Configable ────────────────────────────────────────────────────────────────

model AppConfig {
  id          String   @id
  key         String   @unique
  value         Json
  valueKeyOrder String[] @default([])
  description String?
  isEnabled   Boolean  @default(true)
  scope       String   @default("public")
  tags        String[]
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isEnabled, scope])
  @@map("app_configs")
}
